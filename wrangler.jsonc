{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kevin-machy",
	"compatibility_date": "2026-09-01",
	// `nodejs_compat` donne au Worker une partie des API de Node. Une partie
	// seulement : ni binaire natif, ni système de fichiers.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Le temps processeur, requête par requête.
	//
	// Sans ça, le tableau de bord ne donne qu'une médiane pour tout le Worker —
	// 109 ms le 8 octobre 2026, pour une limite de 10 ms sur le forfait gratuit.
	// Utile pour savoir qu'il y a un problème, inutile pour savoir **quelle
	// page** le cause : mesuré de l'extérieur, le temps de réponse mêle le
	// calcul et l'attente de la base, et seul le calcul compte dans la limite.
	//
	// Gratuit à ce volume : la part offerte est de 200 000 événements par jour,
	// le site en produit environ 6 700. Trois jours de conservation suffisent
	// largement à l'enquête.
	"observability": {
		"enabled": true
	},
	"vars": {
		// Les images restent chez Hostinger : cent gigaoctets déjà payés contre
		// dix chez Cloudflare, servies par Apache sans passer par le Worker, et
		// sans carte bancaire à poser sur le compte du client.
		"COFFRE": "hostinger",
		"GUICHET_MEDIAS": "https://medias.dronezvous.com/guichet-medias.php",
		// D'où le navigateur va chercher les images. Le sous-domaine pointe vers
		// Hostinger, pas vers le Worker : chaque photographie servie ici
		// n'entame pas les cent mille requêtes quotidiennes de Cloudflare.
		"NEXT_PUBLIC_BASE_MEDIAS": "https://medias.dronezvous.com",
		// Dit à la base de passer par Hyperdrive plutôt que par `DATABASE_URI`.
		"BASE": "hyperdrive"
	},
	// Le jeton du guichet n'est pas ici : il se pose à part, et ne traverse
	// jamais le dépôt.
	//   npx wrangler secret put JETON_MEDIAS
	"hyperdrive": [
		{
			// La passerelle vers la MariaDB restée chez Hostinger. Elle tient des
			// connexions déjà ouvertes près d'elle : sans ça, chaque invocation du
			// Worker rouvrirait tout, soit plus de cent millisecondes perdues.
			// Sa mise en cache des lectures est volontairement désactivée : le site
			// a déjà son cache de pages, et empiler les deux ferait qu'une page
			// republiée se refabriquerait parfois avec l'ancien contenu.
			"binding": "HYPERDRIVE",
			"id": "5ec15d5b93d84f13ae16e4f44889027b",
			// Ne sert qu'à l'émulateur local, que les commandes de wrangler
			// démarrent même pour déployer. En ligne, c'est la passerelle
			// ci-dessus qui répond, et cette adresse est ignorée.
			"localConnectionString": "mysql://kevin:kevin@127.0.0.1:3306/kevinmachy"
		}
	],
	"kv_namespaces": [
		{
			// Les pages déjà calculées.
			"binding": "NEXT_INC_CACHE_KV",
			"id": "713636edcb6c4cf69bcb66c5e30e587b"
		}
	],
	"d1_databases": [
		{
			// Le registre qui relie chaque page en cache à ce qu'elle contient.
			// C'est lui qui permet à « Publier » de savoir quoi rafraîchir.
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "kevin-machy-etiquettes",
			"database_id": "6d19748f-0f9a-498c-bf7d-9f4a679086df"
		}
	]
}
