# Combien de temps un navigateur peut garder un fichier sans le redemander.
#
# Sans ce fichier, Cloudflare sert tout avec `max-age=0, must-revalidate` : le
# navigateur revalide chaque image à chaque affichage. Une page de vingt photos
# coûte alors vingt allers-retours qui ne rapportent rien — les fichiers n'ont
# pas changé.
#
# Ce fichier est lu par Cloudflare, pas par Next.js. Il part dans les ressources
# statiques via `public/`, et wrangler l'applique au service des fichiers.

# Les fichiers fabriqués par Next portent une empreinte dans leur nom. À nom
# égal, le contenu est identique — pour toujours. Les revalider n'a aucun sens.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Les polices ne changent pas davantage, et leur nom non plus. Un an.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Les photographies, elles, gardent leur nom d'une construction à l'autre :
# `mariage-hero-wide-1440.avif` désigne l'emplacement, pas l'image. Remplacer
# une photo ne change donc pas son adresse.
#
# D'où un compromis plutôt qu'une éternité : une journée de cache ferme, puis
# une semaine pendant laquelle le navigateur affiche l'ancienne image
# immédiatement tout en allant chercher la nouvelle en arrière-plan. Le visiteur
# n'attend jamais ; une photo remplacée met au pire une journée à apparaître.
#
# Le jour où les images porteront une empreinte dans leur nom, cette règle
# rejoindra les deux précédentes.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Logo, favicon, portrait : mêmes noms stables, même raisonnement, mais ils
# changent encore plus rarement.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
