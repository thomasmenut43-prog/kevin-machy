              {
                "type": "paragraphe",
                "fragments": [
                  {
                    "texte": "Le drone est une alternative aux méthodes d’inspection traditionnelles — la nacelle, l’accès manuel. Il atteint facilement des zones difficiles d’accès ou dangereuses, en réduisant les risques humains et les coûts associés."
                  }
                ]
              },
              {
                "type": "paragraphe",
                "fragments": [
                  {
                    "texte": "Les images et vidéos haute définition capturées pendant le vol vous donnent une base de travail claire pour analyser l’état de vos structures."
                  }
                ]
              }
            ],
            "apparence": {
              "police": "texte",
              "taille": "corps",
              "couleur": "encreAttenuee"
