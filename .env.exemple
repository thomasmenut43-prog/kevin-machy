# Modèle à recopier en `.env`. Aucune vraie valeur ici : ce fichier est versionné.
#
#   cp .env.exemple .env
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# et coller le résultat dans CLE_CHIFFREMENT.

# En local, la base du docker-compose. En ligne, celle de l'hébergeur —
# chez Hostinger, l'hôte est du genre srv000.hstgr.io.
DATABASE_URI=mysql://kevin:kevin@localhost:3306/kevinmachy

# Adresse publique du site, utilisée par l'aperçu en direct du BackOffice.
NEXT_PUBLIC_URL_SITE=http://localhost:3000

# Chiffre le mot de passe SMTP en base.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLE_CHIFFREMENT=
