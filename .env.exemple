# Modèle à recopier en `.env`. Aucune vraie valeur ici : ce fichier est versionné.
#
#   cp .env.exemple .env
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# et coller le résultat dans CLE_CHIFFREMENT.

# En local, la base du docker-compose. En ligne, celle de l'hébergeur —
# chez Hostinger, l'hôte est du genre srv000.hstgr.io.
DATABASE_URI=mysql://kevin:kevin@localhost:3306/kevinmachy

# Adresse publique du site, utilisée par l'aperçu en direct du BackOffice.
NEXT_PUBLIC_URL_SITE=http://localhost:3000

# Chiffre le mot de passe SMTP en base.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLE_CHIFFREMENT=

# Où le navigateur va chercher les photos envoyées depuis le BackOffice.
#
# **Vide en développement, et c'est voulu** : les images passent alors par la
# route /medias/ de l'application, qui les lit sur le disque d'à côté.
#
# En ligne sur Cloudflare, elle porte l'adresse du sous-domaine Hostinger, pour
# qu'Apache serve les photos sans passer par le Worker. Elle est figée dans le
# code au moment de la construction, pas lue à l'exécution : la déclarer dans
# wrangler.jsonc ne suffit donc pas, elle doit aussi être dans l'environnement
# qui construit — voir .github/workflows/deploiement.yml.
NEXT_PUBLIC_BASE_MEDIAS=
